# Install as compose/campus-ldap.env only after DCS confirms a trusted TLS endpoint.
# Replace the URL below with the confirmed LDAPS endpoint, or use ldap:// plus StartTLS.
OVERLEAF_CAMPUS_LDAP_URL=ldaps://users.iitmandi.ac.in:636
OVERLEAF_CAMPUS_LDAP_STARTTLS=false
OVERLEAF_CAMPUS_LDAP_SEARCH_BASE=dc=iitmandi,dc=ac,dc=in
OVERLEAF_CAMPUS_LDAP_SEARCH_FILTER=(&(|(uid={{username}})(mail={{username}}))(mail=*@*)(|(ou:dn:=faculty)(ou:dn:=scholars)(ou:dn:=students_pg)(ou:dn:=students_ug)))
# If required, set a private read-only search account in the installed file.
OVERLEAF_CAMPUS_LDAP_BIND_DN=
OVERLEAF_CAMPUS_LDAP_BIND_CREDENTIALS=
# If DCS uses a private CA, mount its certificate read-only and set the container path.
# OVERLEAF_CAMPUS_LDAP_CA_PATH=/path/in/container/campus-ldap-ca.pem
