# IIT Mandi LaTeX backup settings, read by backup.sh and restore.sh.
# Copy to /etc/iitmandi-latex/backup.env and make it readable by root only:
#   install -m 600 backup.env.example /etc/iitmandi-latex/backup.env

# Overleaf Toolkit checkout that runs the platform
TOOLKIT_DIR=/opt/overleaf-toolkit

# Local working space for the MongoDB dump (about the size of the database)
# and for restores (about the size of all data)
STAGING_DIR=/var/backups/iitmandi-latex

# Off-host restic repository. Examples:
#   SFTP account on a backup server:  sftp:backup@BACKUP_HOST:/srv/restic/iitmandi-latex
#   S3-compatible bucket:             s3:https://S3_HOST/BUCKET/iitmandi-latex
# For S3, also set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY here.
RESTIC_REPOSITORY=sftp:backup@BACKUP_HOST:/srv/restic/iitmandi-latex

# Repository password, one line, root-only. Keep a copy offline: without it
# the backups cannot be read.
RESTIC_PASSWORD_FILE=/etc/iitmandi-latex/restic-password

# Days of daily snapshots to keep
KEEP_DAILY=7

# Optional URL requested after each successful backup, for monitoring
#HEALTHCHECK_URL=
