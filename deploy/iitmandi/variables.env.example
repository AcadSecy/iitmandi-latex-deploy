# IIT Mandi LaTeX: environment for the Toolkit.
# Copy to /opt/iitmandi-latex/toolkit/config/variables.env and replace every
# CHANGE_ME. Never commit the filled-in copy: it holds the secrets below and
# the SMTP and login credentials.

#########
# Site  #
#########

OVERLEAF_APP_NAME="IIT Mandi LaTeX"
OVERLEAF_NAV_TITLE="IIT Mandi LaTeX"
# The address in every share link, invitation and email. Choose the final
# name before the pilot and keep it: links already sent use this address.
OVERLEAF_SITE_URL=https://CHANGE_ME.iitmandi.ac.in
OVERLEAF_ADMIN_EMAIL=CHANGE_ME@iitmandi.ac.in
# AGPL: users must be able to get the source of the version we run.
OVERLEAF_SOURCE_CODE_URL=https://github.com/TayalAditya/iitmandi-latex

# HTTPS is terminated by the proxy in front of the container.
OVERLEAF_BEHIND_PROXY=true
OVERLEAF_SECURE_COOKIE=true
# Name of the login cookie (the upstream default carries the upstream name).
# Changing it later logs everyone out once.
COOKIE_NAME=iitmandi_latex.sid

###########
# Secrets #
###########
# Generate each one once with `openssl rand -hex 32` and never change it.
# Keep a copy offline, next to the backup password.

# Encrypts the share-link tokens in the database. If it changes or is lost,
# every shared link and pending invitation stops working. The app does not
# start without it.
OVERLEAF_INVITE_TOKEN_SECRET=CHANGE_ME
# Signs login cookies. Without it a new random value is made whenever the
# container is recreated (on every update), which logs everyone out.
OVERLEAF_SESSION_SECRET=CHANGE_ME

###########
# Sharing #
###########
# Shared links open only after an IIT Mandi login, so nobody can view or edit
# a project without an account.
OVERLEAF_ALLOW_PUBLIC_ACCESS=false
OVERLEAF_ALLOW_ANONYMOUS_READ_AND_WRITE_SHARING=false

################
# Housekeeping #
################
# Hourly jobs that stop the databases from only ever growing: projects not
# opened for a week are moved out of Redis into MongoDB, and deleted projects
# and accounts are removed for good after 90 days.
ENABLE_CRON_RESOURCE_DELETION=true

#########
# Email #
#########

OVERLEAF_EMAIL_FROM_ADDRESS=CHANGE_ME@iitmandi.ac.in
OVERLEAF_EMAIL_SMTP_HOST=CHANGE_ME
OVERLEAF_EMAIL_SMTP_PORT=587
OVERLEAF_EMAIL_SMTP_SECURE=false
OVERLEAF_EMAIL_SMTP_USER=CHANGE_ME
OVERLEAF_EMAIL_SMTP_PASS=CHANGE_ME
OVERLEAF_EMAIL_SMTP_TLS_REJECT_UNAUTH=true

#################################
# Login with IIT Mandi Google   #
#################################
# Both iitmandi.ac.in and students.iitmandi.ac.in mail is hosted on Google
# Workspace. DCS creates an OAuth client (Web application) in the Institute's
# Google Cloud organisation with the redirect URI
#   <OVERLEAF_SITE_URL>/oidc/login/callback
# If both domains are in the same Workspace organisation, make the consent
# screen "Internal". Either way, only the domains below can create accounts.

EXTERNAL_AUTH=oidc
OVERLEAF_OIDC_PROVIDER_ID=google
OVERLEAF_OIDC_PROVIDER_NAME="IIT Mandi Google account"
OVERLEAF_OIDC_IDENTITY_SERVICE_NAME="Log in with your IIT Mandi email"
OVERLEAF_OIDC_ISSUER=https://accounts.google.com
OVERLEAF_OIDC_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
OVERLEAF_OIDC_TOKEN_URL=https://oauth2.googleapis.com/token
OVERLEAF_OIDC_USER_INFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# Google has no OIDC logout endpoint; send users back to our login page.
OVERLEAF_OIDC_LOGOUT_URL=https://CHANGE_ME.iitmandi.ac.in/login
OVERLEAF_OIDC_CLIENT_ID=CHANGE_ME
OVERLEAF_OIDC_CLIENT_SECRET=CHANGE_ME
OVERLEAF_OIDC_ALLOWED_EMAIL_DOMAINS=iitmandi.ac.in, students.iitmandi.ac.in
OVERLEAF_OIDC_UPDATE_USER_DETAILS_ON_LOGIN=true
# Do not set OVERLEAF_OIDC_IS_ADMIN_FIELD: it accepts a single value and
# removes admin rights from everyone else at their next login. Manage admins
# in Admin > Manage Users instead.

# Accounts come from Google only, so no self-service sign-up page.
OVERLEAF_ENABLE_REGISTRATION_PAGE=false

######################
# Sandboxed compiles #
######################
# Needs SIBLING_CONTAINERS_ENABLED=true in overleaf.rc. Every compile runs in
# its own container with no network.

ALL_TEX_LIVE_DOCKER_IMAGES=texlive/texlive:latest-full, texlive/texlive:TL2025-historic
ALL_TEX_LIVE_DOCKER_IMAGE_NAMES=TeX Live (current), TeX Live 2025
TEX_LIVE_DOCKER_IMAGE=texlive/texlive:latest-full
# Safe inside the sandbox; needed by minted and similar packages.
TEX_COMPILER_EXTRA_FLAGS=-shell-escape

# Seconds per compile. The 126-page thesis in the feasibility test took 168 s.
# Raise it for individual users with the change-compile-timeout script.
COMPILE_TIMEOUT=180

# Real limits for each compile container: 2 GiB memory, 1 CPU, 256 processes.
# Memory is set in both places because the upstream default sits outside
# HostConfig and is 1 TiB.
COMPILE_GROUP_DOCKER_CONFIGS={"standard":{"Memory":2147483648,"HostConfig.Memory":2147483648,"HostConfig.NanoCpus":1000000000,"HostConfig.PidsLimit":256}}

#################
# Compile queue #
#################
# Compiles that may run at once; the rest wait their turn and the PDF appears
# when theirs is done. Requested compiles go before auto-compiles.
# Match the CPUs reserved for compiling (8 in the feasibility test).
COMPILE_QUEUE_SLOTS=8
# Wait plus COMPILE_TIMEOUT must stay below nginx's 10-minute proxy timeout.
COMPILE_QUEUE_MAX_WAIT_SECONDS=300

############################
# Editor sessions          #
############################

# At most this many people (not tabs) can have the editor open at once, as in
# the implementation plan. Others see a waiting page that opens their project
# when a place is free, first come first served. Admins are not counted.
# 0 turns the limit off.
EDITOR_SESSION_LIMIT=50
# Minutes without typing, clicking or scrolling after which a user's place is
# given to the next person waiting.
EDITOR_SESSION_IDLE_MINUTES=30

############################
# Storage                  #
############################

# Default storage per user, counting the files and documents of the projects
# they own. Uploads, zip imports, copies and linked files that would go past it
# are refused; typing never is. Give someone more (or no limit) with:
#   bin/run-script modules/storage-quota/scripts/set-storage-quota.mjs \
#     --email=someone@iitmandi.ac.in --mb=2000      (or --unlimited, --default)
# 0 turns quotas off.
STORAGE_QUOTA_MB=500

############################
# Templates and extras     #
############################

OVERLEAF_TEMPLATE_GALLERY=true
ENABLE_CONVERSIONS=true
OVERLEAF_NON_ADMIN_CAN_PUBLISH_TEMPLATES=false
# User ID of the non-admin account that curates the Institute templates.
# OVERLEAF_TEMPLATES_USER_ID=CHANGE_ME
OVERLEAF_TEMPLATE_CATEGORIES=thesis report homework presentation poster cv formal-letter academic-journal
TEMPLATE_THESIS_NAME=Theses
TEMPLATE_THESIS_DESCRIPTION=MS and PhD theses in the IIT Mandi format.
TEMPLATE_REPORT_NAME=Reports
TEMPLATE_REPORT_DESCRIPTION=BTP and MTP reports, lab reports and project reports.
TEMPLATE_HOMEWORK_NAME=Assignments
TEMPLATE_HOMEWORK_DESCRIPTION=Assignments, problem sets and course material.
TEMPLATE_PRESENTATION_NAME=Presentations
TEMPLATE_PRESENTATION_DESCRIPTION=Beamer slides with the IIT Mandi theme.
TEMPLATE_POSTER_NAME=Posters
TEMPLATE_POSTER_DESCRIPTION=Conference and research posters.
TEMPLATE_CV_NAME=CVs and résumés
TEMPLATE_CV_DESCRIPTION=CVs, résumés and statements of purpose.
TEMPLATE_FORMAL_LETTER_NAME=Letters
TEMPLATE_FORMAL_LETTER_DESCRIPTION=Letters on the Institute letterhead.
TEMPLATE_ACADEMIC_JOURNAL_NAME=Journal articles
TEMPLATE_ACADEMIC_JOURNAL_DESCRIPTION=Article templates for journals and conferences.

# Restore a project or file from its history.
OVERLEAF_HISTORY_RESTORE=true
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file,url
# Upload limit in MB; keep nginx client_max_body_size in step.
MAX_UPLOAD_SIZE=50

# Optional integrations; each needs its own OAuth app or service.
# GITHUB_SYNC_ENABLED=true
# GITHUB_SYNC_CLIENT_ID=CHANGE_ME
# GITHUB_SYNC_CLIENT_SECRET=CHANGE_ME
# ENABLE_PANDOC_CONVERSIONS=true
