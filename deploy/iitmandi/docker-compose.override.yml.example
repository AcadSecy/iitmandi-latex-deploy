# IIT Mandi LaTeX: copy to the Toolkit's config/docker-compose.override.yml.
# Build both images from this repository first, naming them to match below:
#   cd server-ce && make build-base
#   OVERLEAF_TAG=iitmandi/latex:CHANGE_ME make build-community
#   cd .. && docker build -t iitmandi/latex-x-iit-mandi:CHANGE_ME services/git-bridge
---
# Docker keeps everything a container prints, for ever, unless told
# otherwise. Keep at most 3 x 50 MB per container.
x-logging: &logging
  driver: local
  options:
    max-size: 50m
    max-file: "3"

services:
  sharelatex:
    image: iitmandi/latex:CHANGE_ME
    logging: *logging

  # Our git image, Latex X IIT-Mandi, instead of the upstream one
  git-bridge:
    image: iitmandi/latex-x-iit-mandi:CHANGE_ME
    logging: *logging

  mongo:
    # By default MongoDB's cache takes half the RAM, which the compile
    # containers need. 2 GB holds the working set for ~3,500 users; raise it
    # if the database (db.stats().dataSize) grows past ~10 GB. Keep --replSet
    # as the Toolkit sets it: the app needs a replica set.
    command: "--replSet overleaf --wiredTigerCacheSizeGB 2"
    logging: *logging

  redis:
    logging: *logging
