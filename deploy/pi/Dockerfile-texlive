# --------------------------------------------------
# Base image for the Raspberry Pi test server
# --------------------------------------------------
# The Pi runs compiles inside the app container (no per-compile TeX Live
# containers: those images are 5 GB and the Pi has a 29 GB card shared with
# other apps). The upstream base image has only TeX Live's basic scheme, so this
# adds what the IIT Mandi templates and most theses and reports use, without
# the 1.5 GB of extra fonts or the documentation.
#
# Built by .github/workflows/pi-image.yml on top of server-ce/Dockerfile-base.

ARG OVERLEAF_BASE_TAG=sharelatex/sharelatex-base:latest
FROM $OVERLEAF_BASE_TAG

ARG TEXLIVE_MIRROR=https://mirror.ox.ac.uk/sites/ctan.org/systems/texlive/tlnet

RUN tlmgr install --repository ${TEXLIVE_MIRROR} \
      collection-latexrecommended \
      collection-latexextra \
      collection-fontsrecommended \
      collection-pictures \
      collection-mathscience \
      collection-bibtexextra \
      collection-luatex \
      collection-xetex \
      newtx fontaxes kastrup txfonts \
&&  rm -rf /usr/local/texlive/*/tlpkg/backups/*

# biblatex needs biber, and TeX Live has no working biber for arm64. Build the
# version TeX Live lists, so that it matches the biblatex above (a different
# version refuses biblatex's files), from its release on GitHub: CPAN lags
# behind TeX Live. Skipped where TeX Live's own biber runs.
RUN if ! biber --version > /dev/null 2>&1; then \
      version=$(tlmgr info --data cat-version biber) \
  &&  apt-get update \
  &&  apt-get install -y --no-install-recommends cpanminus libssl-dev libxml2-dev libxslt1-dev \
  &&  rm -f /usr/local/bin/biber \
  &&  cpanm --notest --quiet "https://github.com/plk/biber/archive/refs/tags/v$version.tar.gz" \
  &&  rm -rf /root/.cpanm /var/lib/apt/lists/*; \
    fi \
&&  biber --version

# Without the per-compile sandbox, TeX runs as the app's own user. "p"
# (paranoid) stops \input and friends from opening absolute paths or parent
# directories, except under TEXMFOUTPUT, which is the folder that holds every
# project's compile directory. Writing is already restricted the same way.
# It goes in TeX Live's own texmf.cnf, which every TeX run reads: set only in
# the environment it was not in effect. check-tex.sh tests it.
RUN printf '%s\n' 'openin_any = p' 'TEXMFOUTPUT = /var/lib/overleaf/data/compiles' \
      >> "$(kpsewhich -var-value=SELFAUTOPARENT)/texmf.cnf" \
&&  test "$(kpsewhich -var-value=openin_any)" = p
