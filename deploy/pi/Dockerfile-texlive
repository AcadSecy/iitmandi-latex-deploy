# --------------------------------------------------
# Base image for the Raspberry Pi test server
# --------------------------------------------------
# Two uses: the app image is built on it, and every compile runs in a container
# of its own made from it (sandboxed compiles, as in production): no network,
# no secrets, no user data, only the project's compile folder. Its layers are
# already on the Pi as part of the app image, so the sandbox costs no disk.
# pi-deploy tags it as the compile image named in pi.env.
#
# The upstream base image has only TeX Live's basic scheme, so this installs
# all of TeX Live (scheme-full: every package, the journal and publisher
# classes, all fonts and languages), without the documentation and sources
# (tlpdbopt_install_docfiles/srcfiles 0 in Dockerfile-base): about 4.5 GB.
# People bring documents from anywhere, not only the IIT Mandi templates, and
# a missing package is the commonest way for those to fail. The platform has
# its own disk on the Pi for this (README.md).
#
# Built by .github/workflows/pi-image.yml on top of server-ce/Dockerfile-base.

ARG OVERLEAF_BASE_TAG=sharelatex/sharelatex-base:latest
# Two stages, so that CI can keep the long TeX Live install (stage "texlive")
# while the steps after it change
FROM $OVERLEAF_BASE_TAG AS texlive

ARG TEXLIVE_MIRROR=https://mirror.ox.ac.uk/sites/ctan.org/systems/texlive/tlnet

RUN tlmgr install --repository ${TEXLIVE_MIRROR} scheme-full \
&&  rm -rf /usr/local/texlive/*/tlpkg/backups/*

FROM texlive

# biblatex needs biber, and TeX Live has no working biber for arm64. Build the
# version TeX Live lists, so that it matches the biblatex above (a different
# version refuses biblatex's files), from its release on GitHub: CPAN lags
# behind TeX Live. Its XML::LibXSLT does not build from CPAN, so that one comes
# from Ubuntu. Text::BibTeX installs a C library of its own (libbtparse), which
# the linker is then told about. Skipped where TeX Live's own biber runs.
RUN if ! biber --version > /dev/null 2>&1; then \
      version=$(tlmgr info --data cat-version biber) \
  &&  apt-get update \
  &&  apt-get install -y --no-install-recommends cpanminus pkg-config libssl-dev libxml2-dev libxslt1-dev \
        libxml-libxslt-perl \
  &&  mkdir /tmp/biber \
  &&  curl -fsSL "https://github.com/plk/biber/archive/refs/tags/v$version.tar.gz" \
      | tar -xz -C /tmp/biber --strip-components=1 \
  &&  cd /tmp/biber \
  &&  { cpanm --notest --installdeps . || { tail -n 80 /root/.cpanm/build.log; false; }; } \
  &&  perl Build.PL \
  &&  ./Build \
  &&  rm -f /usr/local/bin/biber \
  &&  ./Build install \
  &&  btparse=$(find /usr/local -name 'libbtparse.so*' | head -n 1) \
  &&  echo "${btparse%/*}" > /etc/ld.so.conf.d/btparse.conf \
  &&  ldconfig \
  &&  cd / \
  &&  rm -rf /tmp/biber /root/.cpanm /var/lib/apt/lists/*; \
    fi \
&&  biber --version

# Documents from Word ask for Calibri, Cambria, Times New Roman, Arial or
# Courier New, Microsoft's fonts, which no TeX distribution may include. Free
# fonts with the same metrics, and texmf/fontspec.cfg, which makes fontspec
# load them for those names. fontconfig for fc-cache, which indexes them.
RUN apt-get update \
&&  apt-get install -y --no-install-recommends \
      fontconfig fonts-crosextra-carlito fonts-crosextra-caladea fonts-liberation \
&&  rm -rf /var/lib/apt/lists/* \
&&  fc-cache -f > /dev/null
COPY texmf/ /usr/local/texlive/texmf-local/tex/latex/iitmandi/
RUN mktexlsr /usr/local/texlive/texmf-local > /dev/null 2>&1 \
&&  kpsewhich fontspec.cfg

# The compile service's latexmk settings, which the app image has as well
# (server-ce/config/latexmkrc, given to the build as "config"). Compiles run
# here, and without them latexmk does not run again after a failed compile
# when no file changed, so the editor gets neither a log nor a PDF.
COPY --from=config latexmkrc /usr/local/share/latexmk/LatexMk
# The thesis and report templates load memoize to cache their figures. It needs
# two packages that tlmgr does not install with it (advice, collargs), its
# extraction script on the PATH, and Perl's PDF::API2 to read the figures out
# of the PDF. The package option [extract=tex] stops with "Illegal parameter
# number" on TeX Live 2026, so the templates use the default extraction.
ARG TEXLIVE_MIRROR=https://mirror.ox.ac.uk/sites/ctan.org/systems/texlive/tlnet
RUN tlmgr install --repository ${TEXLIVE_MIRROR} advice collargs \
&&  tlmgr path add \
&&  apt-get update \
&&  apt-get install -y --no-install-recommends libpdf-api2-perl \
&&  rm -rf /var/lib/apt/lists/* /usr/local/texlive/*/tlpkg/backups/*

