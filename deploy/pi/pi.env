# IIT Mandi LaTeX on the Raspberry Pi: settings for the test deployment.
# No secrets here (they are in secrets.env on the Pi, made by setup.sh). The
# production settings are in deploy/iitmandi/variables.env.example; the
# differences below come from the Pi being small and shared.

#########
# Site  #
#########

OVERLEAF_APP_NAME="IIT Mandi LaTeX (test)"
OVERLEAF_NAV_TITLE="IIT Mandi LaTeX (test)"
# Share links and invitations contain this address. pi-deploy replaces it with
# the public tunnel address (site-url.env) as soon as the tunnel is up.
OVERLEAF_SITE_URL=http://172.16.5.146:8095
OVERLEAF_ADMIN_EMAIL=admin@iitmandi-latex.test
# The public address is https through the Cloudflare tunnel; the campus
# address is plain http on port 8095, so the login cookie cannot be https-only.
OVERLEAF_BEHIND_PROXY=true
OVERLEAF_SECURE_COOKIE=false
COOKIE_NAME=iitmandi_latex_test.sid

####################
# Who can get in   #
####################
# Accounts are made by the admin (Admin > Manage Users), never by sign-up:
# without the Institute login configured the sign-up page would otherwise be
# open to anyone with the public link.
OVERLEAF_ENABLE_REGISTRATION_PAGE=false
OVERLEAF_ALLOW_PUBLIC_ACCESS=false
OVERLEAF_ALLOW_ANONYMOUS_READ_AND_WRITE_SHARING=false
SHARE_LINKS_CAN_EDIT=false
# No "From external URL" files: the server would fetch any address a user
# gives it, from inside the campus network.
ENABLED_LINKED_FILE_TYPES=project_file,project_output_file

################
# Housekeeping #
################
# Shorter than production: the card is small and this is test data.
ENABLE_CRON_RESOURCE_DELETION=true
# 7 days, in milliseconds
OVERLEAF_PROJECT_HARD_DELETION_DELAY=604800000
OVERLEAF_USER_HARD_DELETION_DELAY=604800000
TRASH_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=90

############
# Compiles #
############
# Each compile runs in a container of its own (docker-compose.yml), from the
# Pi's base image, which has TeX Live 2026 (Dockerfile-texlive). pi-deploy
# tags that image under this name before the app starts. Projects record the
# name, so it stays the same when the image is rebuilt; a new TeX Live year
# gets a new name, as in production.
TEX_LIVE_DOCKER_IMAGE=iitmandi/texlive-pi:2026.1
ALL_TEX_LIVE_DOCKER_IMAGES=iitmandi/texlive-pi:2026.1
ALL_TEX_LIVE_DOCKER_IMAGE_NAMES=TeX Live 2026
# Safe inside the sandbox, which has no network; needed by minted and the like
TEX_COMPILER_EXTRA_FLAGS=-shell-escape
# Each compile container: 1.5 GiB of memory, 1 CPU, 256 processes
COMPILE_GROUP_DOCKER_CONFIGS={"standard":{"Memory":1610612736,"HostConfig.Memory":1610612736,"HostConfig.NanoCpus":1000000000,"HostConfig.PidsLimit":256}}
# Two at a time on three cores; the rest wait their turn.
COMPILE_TIMEOUT=120
COMPILE_QUEUE_SLOTS=2
COMPILE_QUEUE_MAX_WAIT_SECONDS=300
# As in production: a compile that has run a minute while someone waits is
# paused (`docker pause`) and rejoins the line. Paused compiles keep their
# memory, so at most two at once.
COMPILE_QUEUE_TURN_SECONDS=60
COMPILE_QUEUE_MAX_PAUSED=2
COMPILE_QUEUE_MAX_REQUEST_SECONDS=540

###########
# Editors #
###########
EDITOR_SESSION_LIMIT=15
EDITOR_SESSION_MAX=25
EDITOR_SESSION_IDLE_MINUTES=30

###########
# Storage #
###########
# Everyone gets 50 MB, and up to 200 MB while more than 10% of the card
# (about 3 GB) is free. pi-deploy also stops the platform if the card itself
# gets nearly full, so the other apps on the Pi keep working.
STORAGE_QUOTA_MB=50
STORAGE_MAX_MB=200
STORAGE_DISK_RESERVE_PERCENT=10
MAX_UPLOAD_SIZE=20

##########
# Extras #
##########
OVERLEAF_TEMPLATE_GALLERY=true
OVERLEAF_NON_ADMIN_CAN_PUBLISH_TEMPLATES=false
OVERLEAF_HISTORY_RESTORE=true
ASK_AI_URL=https://chatgpt.com/?q=
ASK_AI_NAME=ChatGPT
